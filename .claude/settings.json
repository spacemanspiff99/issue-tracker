{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app python -m pytest:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app ruff check:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app ruff format --check:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app python -m compileall:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app python -m issue_tracker.mcp.server --smoke)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app alembic current:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app alembic heads:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app alembic history:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml config:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml ps:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker system df:*)",
      "Bash(df -h:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(curl -fsS http://localhost:8000/health)"
    ],
    "ask": [
      "Bash(docker compose -f deployment/docker-compose.local.yml run --rm app alembic upgrade:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml down:*)",
      "Bash(docker compose -f deployment/docker-compose.local.yml up:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker image rm:*)",
      "Bash(docker rm:*)",
      "Bash(gh workflow run:*)",
      "Bash(git push:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune:*)",
      "Bash(playwright install:*)",
      "Bash(python -m playwright install:*)",
      "Bash(python3 -m playwright install:*)",
      "Bash(npx playwright install:*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Read(./.env)",
      "Read(./backups/**)",
      "Read(./**/prod.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-destructive.sh"
          }
        ]
      }
    ]
  }
}
